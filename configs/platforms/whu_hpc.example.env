# Copy to configs/platforms/whu_hpc.env and replace <username>/<account>.
export PLATFORM=nvidia
export PROJECT_ROOT=/home/<username>/JiguangPhantom
export STORAGE_ROOT=/project/<username>
export MODEL_ROOT=${STORAGE_ROOT}/models
export DATA_ROOT=${STORAGE_ROOT}/datasets
export CACHE_ROOT=${STORAGE_ROOT}/cache
export OUTPUT_ROOT=${STORAGE_ROOT}/outputs
export LOG_ROOT=${STORAGE_ROOT}/logs

# Fill these after WHU HPC GPU permission is assigned.
export GPU_PARTITION=<gpu_partition>
export GPU_ACCOUNT=<gpu_account>
